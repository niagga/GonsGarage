# ===========================================
# GonsGarage - Production Environment Variables
# ===========================================
# Copy this file to .env.prod and change the values
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Copiar a `.env.prod` en el servidor (no commitear `.env.prod`).
# Valores ejemplo para LAN 192.168.1.100:8102 (nginx único).

# URL pública que ve el navegador (mismo host/puerto que nginx; sin /api/v1).
# Si accedés también por DuckDNS u otro hostname, incluí ese origen en CORS_ORIGINS abajo;
# el front ajusta en runtime las llamadas /api/v1 a la misma origen que la página (evita bloqueo PNA).
NEXT_PUBLIC_API_URL=http://192.168.1.100:8102

# Orígenes CORS permitidos con GIN_MODE=release (separados por coma). Debe incluir la URL del front.
# Ejemplo con dos entradas: CORS_ORIGINS=http://192.168.1.100:8102,http://gonsgarage.duckdns.org
CORS_ORIGINS=http://192.168.1.100:8102

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_jwt_secret_here
JWT_EXPIRY_HOURS=168
GIN_MODE=release

# Postgres dedicado (P0-T1). Host DNS = servicio compose `postgres` (nunca arnela-postgres).
POSTGRES_USER=gonsgarage_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=gonsgarage
DATABASE_URL=postgres://gonsgarage_app:CHANGE_ME_strong_password_here@postgres:5432/gonsgarage?sslmode=disable
# (opcional) DB_USER / DB_PASSWORD / DB_NAME alineados con lo anterior.

# Redis interno del compose (sin auth; solo red Docker).
REDIS_URL=redis:6379

# --- Fiscal integration (dark launch defaults — keep false until runbook gates pass) ---
# See docs/fiscal-integration-runbook.md and docs/fiscal-integration-traceability.md.
APP_ENV=production
FISCAL_FEATURE_ENABLED=false
FISCAL_FINALIZATION_ENABLED=false
FISCAL_WORKER_ENABLED=false
FISCAL_CLOUDWARE_MUTATIONS=false
# Production refuses mock. Leave empty or set cloudware only after parent 13.2–13.4.
# FISCAL_PROVIDER=cloudware
FISCAL_ARTIFACT_BACKEND=object
# FISCAL_ARTIFACT_OBJECT_ENDPOINT=
# FISCAL_ARTIFACT_OBJECT_BUCKET=
# FISCAL_ARTIFACT_PRIVATE_ACL=true
# FISCAL_ARTIFACT_ENCRYPTION=true
# FISCAL_ARTIFACT_RETENTION=true
# FISCAL_ARTIFACT_BACKUP_RESTORE=true
# FISCAL_ARTIFACT_ACCESS_LOG=true
# Dedicated fiscal credential keyring (never reuse JWT_SECRET):
# FISCAL_CREDENTIAL_KEY_VERSION=v1
# FISCAL_CREDENTIAL_KEY_B64=

