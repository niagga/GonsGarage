# Fiscal outbox worker (Compose profile: fiscal). Finalization/worker remain off unless explicitly enabled.
FROM golang:1.27-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o gonsgarage-fiscal-worker ./cmd/fiscal-worker

FROM alpine:3.21
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /app/gonsgarage-fiscal-worker ./gonsgarage-fiscal-worker
ENTRYPOINT ["./gonsgarage-fiscal-worker"]
